# Enable YouTube Data API v3 in your Google Cloud project and set its API key.
YOUTUBE_API_KEY=

# A video stops being tracked at this age. Restart after changing settings.
TRACKING_WINDOW_DAYS=14

# Collect immediately on startup, then at this interval.
POLL_INTERVAL_MINUTES=5

# Also scan all upload pages periodically to find out-of-order publications.
# The latest uploads are checked on every collection cycle.
FULL_DISCOVERY_INTERVAL_MINUTES=60

# Relative to the directory in which the application starts.
DATABASE_PATH=./data/mrbeast.sqlite

# MrBeast's official main channel. Optional override for another channel.
YOUTUBE_CHANNEL_ID=UCX6OQ3DkcsbYNE6H8uQQuVA
